DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DSH_MODEL=deepseek-v4-flash
FINANA_HOME=~/.finana
# 数据渠道优先级（逗号分隔，可选: eastmoney,sina_tencent,akshare,alltick）
# FINANA_PROVIDER_ORDER=eastmoney,sina_tencent,akshare,alltick
# DSH 运行模式: DSH_RUNTIME=auto|wheel|npm；npm 模式需指定 jsonrpc 入口 js 绝对路径，如 DSH_NPM_BIN=/opt/dsh/jsonrpc-agent.mjs
